COMMERCE_SANDBOX=true
DATABASE_URL=postgres://commerce:commerce_local@localhost:5434/commerce
REDIS_URL=redis://localhost:6381
JWT_SECRET=local-commerce-jwt-change-before-sharing
COOKIE_SECRET=local-commerce-cookie-change-before-sharing
