# STRIPE_WEBHOOK_SECRET=whsec_...

# Server-only credential shared with the API host (api/*): required to save the
# full story and to run paid page corrections. Never prefix it with VITE_.
CREATION_SERVICE_SECRET=local-creation-service-secret-change-before-sharing
