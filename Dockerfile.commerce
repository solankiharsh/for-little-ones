FROM node:22-slim
WORKDIR /app
COPY package.json package-lock.json ./
COPY . .
RUN npm ci --include-workspace-root --no-audit --no-fund
ENV PATH="/app/node_modules/.bin:${PATH}"
ENV NODE_ENV=development
ENV COMMERCE_SANDBOX=true
RUN npm run build --workspace @for-little-ones/commerce
# Medusa build evaluates the config but does not connect to these services.
# Keep real credentials exclusively in runtime Secret Manager bindings.
RUN DATABASE_URL=postgres://build:build@localhost:5432/build \
    REDIS_URL=redis://localhost:6379 \
    JWT_SECRET=build-only COOKIE_SECRET=build-only \
    npm run build --workspace @for-little-ones/commerce-app
WORKDIR /app/apps/commerce
EXPOSE 9000
CMD ["npm", "run", "start"]
