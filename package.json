{
  "name": "for-little-one",
  "version": "0.0.0",
  "private": true,
  "description": "For Little One — personalised children's-book platform (monorepo bootstrap, milestone 0 rails)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pretest": "npm run build:node-packages",
    "test:watch": "vitest",
    "dev:api": "tsx apps/api/src/dev-server.ts",
    "dev:worker": "tsx apps/worker/src/dev-worker.ts",
    "start:api": "tsx apps/api/src/server.ts",
    "start:worker": "tsx apps/worker/src/worker.ts",
    "build:node-packages": "npm run build -w @for-little-ones/domain && npm run build -w @for-little-ones/providers",
    "build:vercel": "npm run build:node-packages && npm run build -w @for-little-ones/web"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": [
    "esbuild",
    "@astryxdesign/core"
  ],
  "optionalDependencies": {
    "@rolldown/binding-linux-arm64-gnu": "1.2.9",
    "@rolldown/binding-linux-x64-gnu": "1.2.9"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@for-little-ones/domain": "*",
    "@for-little-ones/providers": "*",
    "ai": "^7.0.114"
  }
}