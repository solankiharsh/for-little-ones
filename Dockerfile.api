FROM node:22-slim
WORKDIR /app
COPY package.json package-lock.json ./
COPY . .
RUN npm ci --include-workspace-root --no-audit --no-fund
ENV PATH="/app/node_modules/.bin:${PATH}"
# Sandbox stage (mirrors Dockerfile.commerce): tsx runs the TypeScript entry
# points directly and devDependencies stay installed. A compiled emit + dist
# pruning lands if this service graduates past sandbox.
ENV NODE_ENV=development
# Fail the build early if the workspace does not typecheck: a broken image
# must never reach the registry.
RUN npm run typecheck
EXPOSE 8080
# Overridden per service: the API serves HTTP, the worker drains queues.
#   api:    npm run start:api      (apps/api/src/server.ts)
#   worker: npm run start:worker   (apps/worker/src/worker.ts)
CMD ["npm", "run", "start:api"]
